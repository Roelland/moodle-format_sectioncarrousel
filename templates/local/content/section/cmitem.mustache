{{!
    @template core_courseformat/local/content/section/cmitem

    Section Carrousel format: renders each course activity as a Bootstrap card.
    Card structure (top to bottom): icon image, activity title, mark-as-done button.

    Example context (json):
    {
        "id": 3,
        "anchor": "module-3",
        "module": "quiz",
        "extraclasses": "",
        "hasinfo": false,
        "indent": 0,
        "cardicon": "https://example.com/mod/quiz/pix/icon.svg",
        "cardiconclass": "",
        "cardiconpurpose": "assessment",
        "cmformat": {
            "activityname": "My Quiz",
            "url": "https://example.com/mod/quiz/view.php?id=3",
            "cmid": 3,
            "hasname": true,
            "hasurl": true,
            "editing": false,
            "completion": {
                "uservisible": true,
                "showmanualcompletion": true,
                "istrackeduser": true,
                "overallcomplete": false,
                "activityname": "My Quiz"
            }
        }
    }
}}
<li
    class="activity {{module}} modtype_{{module}} {{extraclasses}} {{#hasinfo}}hasinfo{{/hasinfo}} {{#indent}}indented{{/indent}} carrousel-card-item"
    id="{{anchor}}"
    data-for="cmitem"
    data-id="{{id}}"
>
    <div class="card h-100 shadow-sm carrousel-activity-card position-relative">

        {{! ── Card image-top: custom uploaded image, or activity icon as fallback ── }}
        {{#cardimage}}
        <div class="card-img-top carrousel-icon-top position-relative"
             style="background-image: url('{{{cardimage}}}'); background-size: cover; background-position: center;">
            {{#restrictionbadge}}
            {{! Teacher: overlay navigates to the activity (no JS needed) }}
            {{^restrictionlockstudent}}
            <a href="{{{activityurl}}}"
               class="carrousel-restriction-overlay"
               style="position:absolute;inset:0;width:100%;height:100%;background:rgba(0,0,0,0.45);color:#fff;display:flex;align-items:center;justify-content:center;z-index:2;text-decoration:none;">
                <i class="fa fa-lock" style="font-size:3.5rem;pointer-events:none;" aria-hidden="true"></i>
            </a>
            {{/restrictionlockstudent}}
            {{! Student: overlay opens restriction modal }}
            {{#restrictionlockstudent}}
            <button type="button"
                    class="carrousel-restriction-overlay carrousel-restriction-btn"
                    data-restriction-title="{{#str}}restrictionmodaltitle, format_sectioncarrousel{{/str}}"
                    data-restriction-body="{{restrictioninfo}}"
                    aria-label="{{#str}}restrictioninfobtn, format_sectioncarrousel{{/str}}"
                    style="position:absolute;inset:0;width:100%;height:100%;border:none;background:rgba(0,0,0,0.45);color:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;z-index:2;">
                <i class="fa fa-lock" style="font-size:3.5rem;pointer-events:none;" aria-hidden="true"></i>
            </button>
            {{/restrictionlockstudent}}
            {{/restrictionbadge}}
        </div>
        {{/cardimage}}
        {{^cardimage}}
        <div class="card-img-top carrousel-icon-top position-relative {{cardiconpurpose}}">
            <div class="d-flex align-items-center justify-content-center h-100 w-100">
                {{#cardicon}}
                    <img
                        src="{{{cardicon}}}"
                        class="activityicon {{cardiconclass}} carrousel-icon"
                        alt=""
                        aria-hidden="true"
                    >
                {{/cardicon}}
                {{^cardicon}}
                    <span class="carrousel-icon-placeholder"></span>
                {{/cardicon}}
            </div>
            {{#restrictionbadge}}
            {{^restrictionlockstudent}}
            <a href="{{{activityurl}}}"
               class="carrousel-restriction-overlay"
               style="position:absolute;inset:0;width:100%;height:100%;background:rgba(0,0,0,0.45);color:#fff;display:flex;align-items:center;justify-content:center;z-index:2;text-decoration:none;">
                <i class="fa fa-lock" style="font-size:3.5rem;pointer-events:none;" aria-hidden="true"></i>
            </a>
            {{/restrictionlockstudent}}
            {{#restrictionlockstudent}}
            <button type="button"
                    class="carrousel-restriction-overlay carrousel-restriction-btn"
                    data-restriction-title="{{#str}}restrictionmodaltitle, format_sectioncarrousel{{/str}}"
                    data-restriction-body="{{restrictioninfo}}"
                    aria-label="{{#str}}restrictioninfobtn, format_sectioncarrousel{{/str}}"
                    style="position:absolute;inset:0;width:100%;height:100%;border:none;background:rgba(0,0,0,0.45);color:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;z-index:2;">
                <i class="fa fa-lock" style="font-size:3.5rem;pointer-events:none;" aria-hidden="true"></i>
            </button>
            {{/restrictionlockstudent}}
            {{/restrictionbadge}}
        </div>
        {{/cardimage}}

        {{#cmformat}}

        {{! ── Card body: activity title ── }}
        <div class="card-body d-flex flex-column align-items-center justify-content-center text-center p-3">
            {{#hasname}}
            <h6 class="card-title mb-0 fw-semibold">
                {{! Student blocked: title opens restriction modal instead of navigating }}
                {{#restrictionlockstudent}}
                <button type="button"
                        class="carrousel-restriction-btn p-0 border-0 bg-transparent fw-semibold text-body"
                        data-restriction-title="{{#str}}restrictionmodaltitle, format_sectioncarrousel{{/str}}"
                        data-restriction-body="{{restrictioninfo}}"
                        style="cursor:pointer;">
                    {{activityname}}
                </button>
                {{/restrictionlockstudent}}
                {{! Teacher / unrestricted: normal link or plain text }}
                {{^restrictionlockstudent}}
                {{#hasurl}}
                    <a href="{{{url}}}" class="aalink text-body stretched-link">{{activityname}}</a>
                {{/hasurl}}
                {{^hasurl}}
                    {{activityname}}
                {{/hasurl}}
                {{/restrictionlockstudent}}
            </h6>
            {{/hasname}}
        </div>

        {{! ── Card footer: info button (subcourse) + completion button ── }}
        {{#subcoursemodal}}
        <div class="card-footer bg-transparent border-top p-2 carrousel-completion d-flex align-items-center justify-content-center gap-2 position-relative" style="z-index: 2;">
            <button type="button"
                    class="btn btn-secondary btn-sm carrousel-subcourse-info-btn"
                    data-modal="{{subcoursemodaliid}}">
                {{#str}} subcourseinfo, format_sectioncarrousel {{/str}}
            </button>
            {{#completion}}
            {{$ core_courseformat/local/content/cm/completion }}
                {{> core_courseformat/local/content/cm/completion }}
            {{/ core_courseformat/local/content/cm/completion }}
            {{/completion}}
        </div>
        {{/subcoursemodal}}
        {{^subcoursemodal}}
        {{#completion}}
        <div class="card-footer bg-transparent border-top text-center p-2 carrousel-completion position-relative" style="z-index: 2;">
            {{$ core_courseformat/local/content/cm/completion }}
                {{> core_courseformat/local/content/cm/completion }}
            {{/ core_courseformat/local/content/cm/completion }}
        </div>
        {{/completion}}
        {{/subcoursemodal}}

        {{! ── Edit mode: control menu pinned to top-right corner ── }}
        {{#editing}}
        {{#controlmenu}}
        <div class="position-absolute top-0 end-0 m-1" style="z-index: 3;">
            {{$ core_courseformat/local/content/cm/controlmenu }}
                {{> core_courseformat/local/content/cm/controlmenu }}
            {{/ core_courseformat/local/content/cm/controlmenu }}
        </div>
        {{/controlmenu}}
        {{/editing}}

        {{/cmformat}}
    </div>

    {{! ── Hidden description store for the modal (outside .card to avoid overflow:hidden) ── }}
    {{#subcoursemodal}}
    <div id="{{subcoursemodaliid}}" class="d-none"
         data-courseurl="{{subcourseurl}}"
         data-gototext="{{#str}} subcoursegoTo, format_sectioncarrousel {{/str}}">
        <span class="carrousel-modal-title">{{subcoursecoursename}}</span>
        <div class="carrousel-modal-body">{{{subcoursedescription}}}</div>
    </div>
    {{/subcoursemodal}}
</li>
